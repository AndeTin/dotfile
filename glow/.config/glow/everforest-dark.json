{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#D3C6AA",
    "margin": 2
  },
  "block_quote": {
    "color": "#859289",
    "italic": true,
    "indent": 2,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "color": "#D3C6AA",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#E67E80",
    "background_color": "#343F44",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#E69875",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#DBBC7F",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "#A7C080",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "#7FBBB3",
    "bold": true
  },
  "h6": {
    "prefix": "###### ",
    "color": "#D699B6",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "color": "#D3C6AA",
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#7A8478",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#A7C080"
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#7FBBB3"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#7FBBB3",
    "underline": true
  },
  "link_text": {
    "color": "#83C092",
    "bold": true
  },
  "image": {
    "color": "#D699B6",
    "underline": true
  },
  "image_text": {
    "color": "#859289",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#E69875",
    "background_color": "#343F44"
  },
  "code_block": {
    "color": "#D3C6AA",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#D3C6AA"
      },
      "error": {
        "color": "#E67E80",
        "background_color": "#514045"
      },
      "comment": {
        "color": "#859289"
      },
      "comment_preproc": {
        "color": "#D699B6"
      },
      "keyword": {
        "color": "#E67E80"
      },
      "keyword_reserved": {
        "color": "#E67E80"
      },
      "keyword_namespace": {
        "color": "#E67E80"
      },
      "keyword_type": {
        "color": "#DBBC7F"
      },
      "operator": {
        "color": "#E69875"
      },
      "punctuation": {
        "color": "#9DA9A0"
      },
      "name": {
        "color": "#D3C6AA"
      },
      "name_builtin": {
        "color": "#D699B6"
      },
      "name_tag": {
        "color": "#E69875"
      },
      "name_attribute": {
        "color": "#7FBBB3"
      },
      "name_class": {
        "color": "#DBBC7F",
        "underline": true,
        "bold": true
      },
      "name_constant": {
        "color": "#83C092"
      },
      "name_decorator": {
        "color": "#DBBC7F"
      },
      "name_exception": {
        "color": "#E67E80"
      },
      "name_function": {
        "color": "#A7C080"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#D699B6"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#A7C080"
      },
      "literal_string_escape": {
        "color": "#83C092"
      },
      "generic_deleted": {
        "color": "#E67E80"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#A7C080"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#7A8478"
      },
      "background": {
        "background_color": "#232A2E"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}